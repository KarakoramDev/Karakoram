VERSION ?= $(or $(KARAKORAM_VERSION),dev)
COMMIT ?= $(or $(KARAKORAM_COMMIT),$(shell git rev-parse --short HEAD 2>/dev/null || printf unknown))
BUILD_DATE ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS = -s -w -X github.com/KarakoramDev/Karakoram/internal/version.Version=$(VERSION) -X github.com/KarakoramDev/Karakoram/internal/version.Commit=$(COMMIT) -X github.com/KarakoramDev/Karakoram/internal/version.BuildDate=$(BUILD_DATE)
UI_TAGS = $(if $(wildcard internal/ui/dist/index.html),-tags ui,)
.PHONY: build build-all generate test test-integration e2e lint ui openapi-check
build:
	mkdir -p bin
	CGO_ENABLED=0 go build $(UI_TAGS) -ldflags '$(LDFLAGS)' -o bin/karakoram ./cmd/karakoram
	CGO_ENABLED=0 go build $(UI_TAGS) -ldflags '$(LDFLAGS)' -o bin/karactl ./cmd/karactl
build-all: ui
	$(MAKE) build
generate:
	go generate ./...
test:
	go test ./...
test-integration:
	go test -tags integration ./test/integration/...
e2e:
	@test -n "$$KARAKORAM_E2E_URL" -a -n "$$KARAKORAM_E2E_TOKEN" || { printf '%s\n' 'Set KARAKORAM_E2E_URL and KARAKORAM_E2E_TOKEN'; exit 1; }
	go test -tags e2e ./test/e2e/...
lint:
	go vet ./...
	# internal/api and pkg/client contain code generated by oapi-codegen.
	go run honnef.co/go/tools/cmd/staticcheck@2025.1.1 $$(go list ./... | grep -v -e '/internal/api$$' -e '/pkg/client$$')
	@if [ -d ui ]; then cd ui && npm run typecheck && npm run lint; fi
ui:
	cd ui && npm ci && npm run build
openapi-check: generate
	git diff --exit-code -- api internal/api pkg/client
