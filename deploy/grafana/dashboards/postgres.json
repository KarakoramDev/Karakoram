{
  "uid": "karakoram-postgres",
  "title": "Karakoram / Postgres",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "karakoram",
    "postgres"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(karakoram_member_scrape_success, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(karakoram_member_scrape_success{namespace=~\"$namespace\"}, cluster)",
          "refId": "cluster"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "member",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(karakoram_member_scrape_success{namespace=~\"$namespace\",cluster=~\"$cluster\"}, member)",
          "refId": "member"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Patroni primary",
      "description": "No data means unknown, unavailable, not applicable, or not authorized; it is never a healthy zero. Timestamp zero means never recorded. Enable member monitoring for engine metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "karakoram_postgres_patroni_primary{namespace=~\"$namespace\",cluster=~\"$cluster\",member=~\"$member\"}",
          "legendFormat": "{{namespace}} / {{cluster}} / {{member}} {{database}} {{component}} {{schedule}} {{certificate}} {{channel}} {{type}} {{status}} {{reason}} {{operation}} {{pool}} {{collector}} {{slot}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No data \u2014 unknown",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
